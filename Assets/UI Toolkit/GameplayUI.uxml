<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center;">
        <ui:VisualElement name="CharacterCenterImage" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; -unity-background-scale-mode: scale-to-fit; background-color: rgb(0, 0, 0);"/>
        <ui:VisualElement name="EscMenuPanel" style="flex-grow: 1; flex-direction: row; width: 100%; height: 100%; padding-top: 3%; padding-right: 3%; padding-bottom: 3%; padding-left: 3%;">
            <ui:VisualElement name="IconsBox" style="flex-grow: 0; width: 6%; height: 45%; align-self: flex-start; flex-shrink: 0; flex-direction: column; margin-right: 0%; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); background-color: rgba(12, 12, 14, 0.51);"/>
            <ui:VisualElement name="CharacterBox" style="flex-grow: 0; background-size: 42% 100%; padding-top: 3%; padding-right: 3%; padding-bottom: 3%; padding-left: 3%; background-color: rgba(12, 12, 14, 0.51); border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; width: 40%; flex-shrink: 0; align-self: stretch;">
                <ui:Label text="Label" name="EscClassLabel" style="width: 100%; margin-top: 0; margin-right: 0; margin-bottom: 1%; margin-left: 0; font-size: 24px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; color: rgb(255, 255, 255);"/>
                <ui:Label text="Label" name="EscPhobiaLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 3%; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 100%; font-size: 18px; color: rgb(255, 255, 255);"/>
                <ui:Image name="EscPortrait" style="width: 55%; height: 42%; -unity-background-scale-mode: scale-to-fit; margin-bottom: 3%;"/>
                <ui:Label text="Label" name="HungerLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 1.5%; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 75%; border-bottom-width: 2px; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0); color: rgb(255, 255, 255);"/>
                <ui:Label text="Body" name="BodyLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 1.5%; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 75%; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0); border-bottom-width: 2px; color: rgb(255, 255, 255);"/>
                <ui:Label text="Label" name="MindLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 3%; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 75%; height: auto; border-bottom-width: 2px; border-left-color: rgb(255, 0, 0); border-right-color: rgb(255, 0, 0); border-top-color: rgb(255, 0, 0); border-bottom-color: rgb(255, 0, 0); color: rgb(255, 255, 255);"/>
                <ui:Button text="Eat&#10;" name="EatButton" style="margin-top: 4%; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2%; padding-right: 0; padding-bottom: 2%; padding-left: 0; width: 35%; height: auto;"/>
                <ui:Button text="Rest&#10;" name="RestButton" style="margin-top: 4%; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 2%; padding-right: 0; padding-bottom: 2%; padding-left: 0; width: 35%; height: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
