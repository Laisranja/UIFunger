<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Root" style="flex-grow: 1; width: 100%; height: 100%; justify-content: space-between; align-items: center; padding-top: 3%; padding-right: 3%; padding-bottom: 3%; padding-left: 3%; background-color: rgb(18, 18, 18);">
        <ui:VisualElement name="CharacterRow" style="flex-grow: 0; width: 100%; height: 62%; flex-direction: row; flex-shrink: 0; align-items: flex-end; justify-content: center; align-self: auto;">
            <ui:Image name="Cahara" style="width: 20%; height: 85%; margin-right: 6px; background-image: url(&quot;project://database/Assets/Characters/cahara.png?fileID=3313030888661112171&amp;guid=eca3fcf1f399ac349b4b3e1a33163673&amp;type=3#cahara_0&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:Image name="Darce" style="width: 20%; height: 85%; margin-right: 6px; margin-left: 0; background-image: url(&quot;project://database/Assets/Characters/darce.png?fileID=-229281323066771886&amp;guid=3068c777d991d134f8b4b681dcec5121&amp;type=3#darce_0&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:Image name="Enki" style="width: 20%; height: 85%; margin-right: 6px; background-image: url(&quot;project://database/Assets/Characters/enki.png?fileID=-4090705698996245025&amp;guid=64f37ac688c433d4b9cce2dbf01b8d08&amp;type=3#enki_0&quot;); -unity-background-scale-mode: scale-to-fit;"/>
            <ui:Image name="Ragn" style="height: 85%; width: 20%; background-image: url(&quot;project://database/Assets/Characters/ragn.png?fileID=28395405289178871&amp;guid=8a43bf1b21eacc340ada516c596149df&amp;type=3#ragn_0&quot;); -unity-background-scale-mode: scale-to-fit;"/>
        </ui:VisualElement>
        <ui:VisualElement name="DescriptionBox" style="flex-grow: 1; width: 85%; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px; align-self: center; height: auto; margin-top: 16px; background-color: rgb(20, 20, 20); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255);">
            <ui:Label text="&#10;" name="ClassNameLabel" style="-unity-text-align: upper-center; color: rgb(255, 255, 255); font-size: 20px;"/>
            <ui:Label text="SELECT YOUR&#10;CHARACTER" name="ClassDescLabel" style="white-space: normal; color: rgb(255, 255, 255); -unity-text-align: middle-center; font-size: 20px; justify-content: flex-start; align-content: flex-start;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
